# =============================================================================
# Marine Pollution Intelligence & Vessel Attribution Platform - environment
# configuration.
#
# This is an EXAMPLE file - it contains no real credentials. Copy it to
# `.env` and edit as needed:
#
#   cp .env.example .env
#
# Every variable below has a safe, working default (shown as the value
# here, or commented-out-and-empty for anything credential-shaped) baked
# into backend/app/config.py, so the app runs correctly with ZERO
# environment configuration - none of this is required. Set a variable
# only to override that default. AUTH_SECRET_KEY and the *_LIVE_API_KEY
# variables are the only credential-shaped settings this codebase has;
# all are commented out / obviously-fake by default and must be set
# explicitly to do anything.
#
# The backend does not auto-load `.env` files (no extra dependency such as
# python-dotenv is introduced for this prototype); export these in your
# shell, your process manager, or your container orchestrator. See
# README.md "Configuration" for OS-specific examples.
# =============================================================================

# ---- App / environment identity --------------------------------------------
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ---- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins. "*" preserves this prototype's
# original (pre-hardening) behavior. Set an explicit origin list for any
# real deployment, e.g.: CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
CORS_ALLOWED_ORIGINS=*

# ---- Uploads ------------------------------------------------------------------
# Maximum accepted upload size, in megabytes, enforced by streaming byte
# count (not by trusting the client's Content-Length header).
MAX_UPLOAD_SIZE_MB=50
# Comma-separated allowed file extensions per upload endpoint.
ALLOWED_AIS_EXTENSIONS=.csv
ALLOWED_SATELLITE_EXTENSIONS=.tif,.tiff,.png,.jpg,.jpeg

# ---- Processing ---------------------------------------------------------------
PROCESSING_TIMEOUT_SECONDS=60

# ---- ML -------------------------------------------------------------------------
# Confidence below which the orchestrator discards the ML prototype's
# result and falls back to the classical detector. This is a heuristic
# engineering cutoff, NOT a scientifically validated operating point - see
# MODEL_CARD.md / README_ML_STATUS.md.
ML_FALLBACK_CONFIDENCE_THRESHOLD=0.5

# ---- AIS / attribution -----------------------------------------------------------
AIS_SEARCH_RADIUS_KM_DEFAULT=50
AIS_TIME_WINDOW_HOURS_DEFAULT=12

# ---- Drift hindcast/forecast duration (comma-separated hour offsets) ------------
DRIFT_BACKWARD_HOURS=6,12,18,24
DRIFT_FORWARD_HOURS=6,12,24,48

# ---- Map --------------------------------------------------------------------------
# Preferred basemap tile provider name (informational - the frontend has
# its own provider fallback chain regardless; see InteractiveMap.jsx).
MAP_TILE_PROVIDER=osm

# ---- Persistence (SQLite by default - see DATA_PIPELINE.md §6) ------------------
DATABASE_ENABLED=true
# DATABASE_PATH=./backend/data/app.db

# Set to a postgres:// or postgresql:// URL to use a real PostgreSQL server
# instead of SQLite - e.g. for a cloud deployment (Render, etc.) whose
# filesystem does not survive a restart/redeploy. Takes priority over
# DATABASE_PATH entirely when set; leave unset for local SQLite (the
# default, and all that's needed for the local SIH demo). Requires
# `pip install -r requirements-postgres.txt` (not installed by default -
# see that file for why). Genuinely tested against a real local
# PostgreSQL 16 server during development, not just written against the
# driver's docs - see backend/tests/test_persistence_postgres.py.
#   DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Authentication (disabled by default - see app/auth.py, DEMO_GUIDE.md) ------
AUTH_ENABLED=false
# AUTH_SECRET_KEY=change-me-to-a-real-random-secret-for-any-real-deployment
AUTH_TOKEN_EXPIRE_MINUTES=120
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234
AUTH_ALLOW_REGISTRATION=true

# ---- Upload hardening -------------------------------------------------------------
MAX_IMAGE_DIMENSION_PX=8000

# ---- Real Zenodo dataset integration (offline CLIs only - see docs/DATASET_SETUP.md) --
# Where you extracted the real Zenodo Sentinel-1 SAR Oil Spill Dataset after
# downloading it yourself (see docs/DATASET_SETUP.md - it is NOT included in
# this repository or any distributed ZIP, and nothing downloads it
# automatically). Only read by the offline `python -m app.ml.dataset` /
# `app.ml.train` / `app.ml.evaluate_real` CLIs - never by the running
# FastAPI app, so leaving this at the default is always safe even with no
# dataset downloaded; the synthetic demo, classical detector, and shipped
# ML prototype all keep working fully offline regardless.
DATASET_ROOT=./data/zenodo_sar

# How long (seconds) `GET /api/ml/dataset-status` may serve a cached result
# before re-running the full filesystem + TIFF validation scan against
# DATASET_ROOT. This is what lets the ML Training page's Dataset Status
# section load quickly on repeat visits instead of rescanning a large
# dataset every time. `GET /api/ml/dataset-status?refresh=true` (the page's
# "Refresh dataset status" button) always bypasses this and rescans now.
DATASET_STATUS_CACHE_TTL_SECONDS=300

# Defaults for `python -m app.ml.train` (all overridable via CLI flags -
# see docs/DATASET_SETUP.md and MODEL_CARD.md §6b for the full commands).
ML_TRAIN_BATCH_SIZE=4
ML_TRAIN_EPOCHS=20
ML_TRAIN_LR=0.001
ML_TRAIN_IMAGE_SIZE=256
ML_TRAIN_SEED=42
ML_CHECKPOINT_DIR=./backend/data/ml_checkpoints

# ---- Legacy alias -----------------------------------------------------------------
# Historically a documented, inert placeholder; kept for backward
# compatibility with any existing deployment's .env file. Still read
# nowhere in the request-serving path - see app/config.py.
ENABLE_ZENODO_DATA=false

# =============================================================================
# Live data providers - UNSET (empty) BY DEFAULT. Set the *_PROVIDER_URL
# below to actually enable a live fetch attempt (see app/ais/live_provider.py
# and app/environment/adapters.py::RealWeatherOceanAdapter). Neither has
# been validated against a real provider from this project's own
# development sandbox (no network egress to any AIS/weather API there) -
# see DATA_PIPELINE.md §2a/§3 for exactly what verifying a specific real
# provider would still require. Leaving these unset preserves the existing
# synthetic-fallback demo behavior with zero configuration.
# =============================================================================
# AIS_LIVE_PROVIDER_URL=
# AIS_LIVE_API_KEY=
AIS_LIVE_TIMEOUT_SECONDS=10
AIS_LIVE_MAX_RETRIES=2

# ENV_LIVE_PROVIDER_URL=
# ENV_LIVE_API_KEY=
ENV_LIVE_TIMEOUT_SECONDS=10
ENV_LIVE_MAX_RETRIES=2

# MAP_TILE_PROVIDER_API_KEY=

